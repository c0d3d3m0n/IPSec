{
    "policy_id": "cross-tunnel-linux-side",
    "version": "1.0",
    "description": "Linux to Windows tunnel — Linux side (10.59.239.13 → 10.59.239.5)",
    "target": {
        "os": [
            "linux"
        ],
        "device_groups": [
            "tunnel-test"
        ]
    },
    "ipsec_policy": {
        "mode": "tunnel",
        "key_exchange": "ikev2",
        "authentication": {
            "type": "psk",
            "secret_ref": "TUNNEL_TEST_PSK"
        },
        "crypto": {
            "ike": {
                "encryption": "aes256",
                "integrity": "sha256",
                "dh_group": "ecp256"
            },
            "esp": {
                "encryption": "aes256",
                "integrity": "sha256",
                "dh_group": "ecp256",
                "pfs": false
            }
        },
        "connections": [
            {
                "name": "corporate-vpn",
                "local_ip": "10.93.10.13",
                "local_subnet": "10.93.10.13/32",
                "remote_ip": "10.93.10.155",
                "remote_subnet": "10.93.10.155/32",
                "auto_start": true
            }
        ]
    },
    "execution": {
        "retry_count": 3,
        "timeout_seconds": 60,
        "rollback_on_failure": true
    },
    "compliance": {
        "require_strong_crypto": false,
        "require_pfs": false
    }
}