{
  "policy_id": "ipsec-linux-only-001",
  "version": "1.1",
  "description": "Linux-only IPSec policy",
  "target": {
    "os": ["linux"],
    "device_groups": ["cloud-gateways"]
  },
  "ipsec_policy": {
    "mode": "tunnel",
    "key_exchange": "ikev2",
    "authentication": {
      "type": "psk",
      "secret_ref": "SuperSecretLinuxKeyThisTime!"
    },
    "crypto": {
      "ike": {
        "encryption": "aes256",
        "integrity": "sha256",
        "dh_group": "modp3072"
      },
      "esp": {
        "encryption": "aes256",
        "integrity": "sha256",
        "dh_group": "modp3072",
        "pfs": true
      }
    },
    "connections": [
      {
        "name": "corporate-vpn-linux",
        "local_ip": "10.100.0.5",
        "local_subnet": "10.100.0.0/16",
        "remote_ip": "172.16.0.5",
        "remote_subnet": "172.16.0.0/16",
        "auto_start": true
      }
    ]
  },
  "execution": {
    "retry_count": 5,
    "timeout_seconds": 120,
    "rollback_on_failure": true
  },
  "compliance": {
    "require_strong_crypto": true,
    "require_pfs": true
  }
}
